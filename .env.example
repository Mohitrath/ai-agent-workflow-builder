# --- Hasura / nhost core ---
NHOST_ADMIN_SECRET=changeme
NHOST_GRAPHQL_URL=https://<subdomain>.graphql.<region>.nhost.run/v1/graphql

# --- LLM provider for llm_call steps (Groq's OpenAI-compatible API) ---
# Leave unset to use the disclosed stub (adds an artificial 800ms delay,
# returns "[STUBBED LLM RESPONSE ...]") so the rest of the system still
# runs end-to-end without a key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Notify step delivery (optional) ---
SLACK_WEBHOOK_URL=

# --- Action / Event Trigger / Cron handler URLs ---
# These point Hasura at your deployed nhost Functions. With the nhost CLI /
# nhost Cloud, functions are auto-deployed from /functions and reachable at
# https://<subdomain>.functions.<region>.nhost.run/v1/<filename-without-ext>
NHOST_FUNCTIONS_TRIGGER_WORKFLOW_RUN_URL=https://<subdomain>.functions.<region>.nhost.run/v1/trigger-workflow-run
NHOST_FUNCTIONS_APPROVE_STEP_URL=https://<subdomain>.functions.<region>.nhost.run/v1/approve-step
NHOST_FUNCTIONS_SEND_NOTIFICATION_URL=https://<subdomain>.functions.<region>.nhost.run/v1/send-notification
NHOST_FUNCTIONS_DATABASE_EVENT_URL=https://<subdomain>.functions.<region>.nhost.run/v1/database-event-trigger
NHOST_FUNCTIONS_SCHEDULED_RUNNER_URL=https://<subdomain>.functions.<region>.nhost.run/v1/scheduled-runner

# Webhook trigger endpoint (not templated into metadata — used directly by
# external callers): https://<subdomain>.functions.<region>.nhost.run/v1/webhook-trigger/:triggerId
